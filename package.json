{
  "name": "@rasyid_rafi/opencode-antigravity",
  "version": "0.6.4",
  "packageManager": "bun@1.4.4",
  "description": "Standalone LLM API and OpenCode V2 provider for Google Antigravity ACP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffusion/opencode-antigrvity.git"
  },
  "homepage": "https://github.com/jeffusion/opencode-antigrvity#readme",
  "bugs": {
    "url": "https://github.com/jeffusion/opencode-antigrvity/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    "./rpc": {
      "types": "./dist/telemetry-rpc.d.ts",
      "import": "./src/telemetry-rpc.ts",
      "default": "./src/telemetry-rpc.ts"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "precompile": "bun run scripts/clean.ts",
    "compile": "bun run --bun tsc -p tsconfig.json",
    "build:service": "bun run scripts/build-service.ts",
    "pretest": "bun run compile",
    "test": "bun test test",
    "test:live": "OPENCODE_ANTIGRAVITY_ACP_LIVE=1 bun test test/acp-live.test.ts",
    "check": "bun run compile && bun test test",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@opencode/plugin": "2.0.22",
    "fflate": "^0.8.2",
    "koffi": "^3.3.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "antigravity",
    "google-antigravity",
    "anthropic-messages",
    "google"
  ]
}
